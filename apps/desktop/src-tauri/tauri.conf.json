{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keirost",
  "version": "0.1.0",
  "identifier": "com.keirost.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Keirost",
    "copyright": "Keirost",
    "shortDescription": "Keirost ERP",
    "longDescription": "Aplicación de escritorio de Keirost ERP.",
    "resources": ["keirost-web/**/*"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
