{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keirost",
  "version": "0.1.0",
  "identifier": "com.keirost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @keirost/desktop-ui",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build --workspace @keirost/desktop-ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keirost",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Keirost",
    "copyright": "Keirost",
    "shortDescription": "Keirost ERP",
    "longDescription": "Aplicación de escritorio de Keirost ERP.",
    "resources": ["keirost-web/**/*"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
