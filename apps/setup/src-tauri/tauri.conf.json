{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keirost Setup",
  "identifier": "com.keirost.setup",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keirost Setup",
        "width": 980,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Keirost",
    "copyright": "Keirost",
    "shortDescription": "Instalador de Keirost",
    "longDescription": "Instala Keirost ERP en Windows: base de datos, servidor y aplicación de escritorio, como servicios del sistema.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Spanish"],
        "installMode": "perMachine"
      }
    }
  }
}
