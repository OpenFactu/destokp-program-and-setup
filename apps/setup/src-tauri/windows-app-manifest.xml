<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Keirost Setup registra servicios de Windows, escribe en «Archivos de
       programa» y crea el cluster de PostgreSQL: sin elevación no puede hacer
       nada de eso. Pedirla en el manifiesto hace que Windows muestre el aviso
       de UAC al abrirlo, en vez de dejar que el usuario llegue hasta la mitad
       del asistente y se encuentre con un error. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Estilos visuales modernos; viene del manifiesto por defecto de Tauri y
       hay que conservarlo al sustituirlo. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <!-- Sin esto, Windows aplica compatibilidad de versiones antiguas y la
       ventana sale borrosa en pantallas con escalado. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
    </application>
  </compatibility>
</assembly>
